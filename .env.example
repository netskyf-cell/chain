# Copy to .env for local development. Never commit .env.
# Optional locally: without it, GitHub allows 60 unauthenticated calls per hour.
# Required on Vercel: a fine-grained token with read-only access to public repositories.
GITHUB_DEMO_TOKEN=

# S1b (SETUP.md "S1b"). Optional locally: without them, /api/state and webhooks are off
# and demo mode works as before. GITHUB_APP_PRIVATE_KEY: paste the .pem content in quotes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
